# Local development. For Render, set these in the service dashboard instead.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Use a local PostgreSQL server or DATABASE_URL from your hosted PostgreSQL service.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=iips_restaurant
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
# Render usually provides DATABASE_URL automatically when the database is attached.
# DATABASE_URL=postgresql://...
# Generate a long random secret (at least 32 characters).
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Bootstrap initial admin once. Use a strong unique password and do not commit it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_12_chars_minimum
